DATABASE_URL=mysql://rustbox:change-me@127.0.0.1:3306/rustbox
MAIN_APP_API_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret
MICROSOFT_TENANT_ID=replace-with-tenant-id
MICROSOFT_APPLICATION_CLIENT_ID=replace-with-application-client-id
MICROSOFT_APPLICATION_CLIENT_SECRET=replace-with-application-client-secret
NATIVE_PUBLIC_URL=https://rustbox.example.com
